{
  "name": "techverse",
  "version": "0.1.0",
  "private": true,
  "description": "TECHVERSE — catalogue historique des produits Apple commercialisés depuis le 1er janvier 2016",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:check": "tsx scripts/check-catalog.ts",
    "catalog:export": "tsx scripts/export-catalog.ts",
    "sources:verify": "tsx scripts/verify-sources.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "gsap": "3.12.5",
    "jose": "5.9.6",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
