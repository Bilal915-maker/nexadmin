# --- Source du catalogue -------------------------------------------------
# "files"    : lit les fichiers data/catalog/** (aucune base requise)
# "database" : lit PostgreSQL via Prisma (requis pour l'administration)
# Si absent : "database" quand DATABASE_URL est défini, sinon "files".
CATALOG_SOURCE=files

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/techverse?schema=public"

# --- Administration ---------------------------------------------------------
# E-mail de l'administrateur
ADMIN_EMAIL=admin@example.com
# Hash scrypt du mot de passe : npm run admin:hash -- "mot-de-passe-long"
ADMIN_PASSWORD_HASH=
# Secret de signature des sessions (32+ caractères aléatoires) : openssl rand -base64 48
ADMIN_SESSION_SECRET=

# --- SEO ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
